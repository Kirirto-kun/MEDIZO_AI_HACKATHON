{
  "expo": {
    "name": "DocJob",
    "slug": "docjob",
    "scheme": "docjob",
    "version": "1.1.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.docjob.app",
      "buildNumber": "3"
    },
    "android": {
      "package": "com.docjob.app",
      "versionCode": 3,
      "adaptiveIcon": {
        "backgroundColor": "#051620",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#051620",
          "image": "./assets/splash-icon.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#051620",
            "image": "./assets/splash-icon.png"
          }
        }
      ],
      "expo-secure-store",
      "expo-localization",
      "./plugins/with-legacy-download-permission",
      "./plugins/with-secure-release-signing"
    ]
  }
}
